# Copy this file to .env (or export these manually) to configure the portal.
# Nothing here is required to run the app -- every value has a safe default,
# and the AI insights feature falls back to a rule-based narrative whenever the
# local model is unavailable.

# ---- Django ----
# PEER_DEBUG=1
# PEER_SECRET_KEY=replace-with-a-random-string-before-any-shared-deployment

# ---- AI insights (local model via Ollama -- no API key, no data leaves the machine) ----
# Setup: install Ollama from https://ollama.com/download, then: ollama pull llama3.2
# PEER_AI_ENABLED=1
# PEER_AI_MODEL=llama3.2
# PEER_AI_API_URL=http://127.0.0.1:11434/api/chat
# PEER_AI_TIMEOUT=90
# PEER_AI_MAX_TOKENS=1200
# PEER_AI_CACHE_SECONDS=900
